# Copy this file to .env and enter real values only in the copied file.
# Never expose APIM_KEY through a NEXT_PUBLIC_ variable.

APIM_BASE_URL=https://your-apim.azure-api.net/foundry
APIM_KEY=replace-with-apim-key

CHAT_MODEL=replace-with-chat-model
EMBEDDING_MODEL=replace-with-embedding-model
VISION_MODEL=replace-with-vision-model

# FastAPI authentication and PostgreSQL
DATABASE_URL=postgresql+psycopg://giljabi:change-me@db:5432/giljabi
COOKIE_SECURE=true
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,https://good.youthai.site
POSTGRES_DB=giljabi
POSTGRES_USER=giljabi
POSTGRES_PASSWORD=change-me
